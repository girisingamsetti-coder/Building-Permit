# ─────────────────────────────────────────────────────────────────────────
# LAMS — environment
#
# Everything here is parsed ONCE at boot by src/server/config/env.ts through a
# Zod schema that fails fast and names every missing key. Nothing else in the
# codebase reads process.env.
#
# This file holds SECRETS AND INFRASTRUCTURE only. Business configuration —
# SLA days, rounding rules, mock scrutiny behaviour — lives in the
# system_settings table and is edited in the admin UI. See docs A.6.
# ─────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Application ──────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
APP_NAME="LTP Approval Management System"
ORG_SHORT_NAME=LAMS

# ── Database ─────────────────────────────────────────────────────────────
# DATABASE_URL is the pooled connection used by the application.
# DIRECT_URL is a direct connection used by `prisma migrate`, which cannot run
# through a transaction pooler. Falls back to DATABASE_URL when unset.
DATABASE_URL=postgresql://lams:lams@localhost:5433/lams?schema=public
DIRECT_URL=postgresql://lams:lams@localhost:5433/lams?schema=public

# ── Auth ─────────────────────────────────────────────────────────────────
# Generate with:  openssl rand -base64 48
# MUST be at least 32 characters. The app refuses to boot with the sample value
# when NODE_ENV=production.
AUTH_SECRET=dev-only-secret-change-me-at-least-32-chars-long
ACCESS_TOKEN_TTL_MINUTES=15
SESSION_IDLE_TTL_HOURS=8
SESSION_ABSOLUTE_TTL_HOURS=24
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# ── Storage ──────────────────────────────────────────────────────────────
# STORAGE_PROVIDER: local | s3
# The bucket must be PRIVATE. Downloads are served through signed URLs issued
# by the app after re-checking authorization. See docs P.4.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./.storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300
MAX_UPLOAD_MB=25

# ── External service drivers ─────────────────────────────────────────────
# Every one of these is an adapter. Business code never learns which is live.
# Only the mock/console/noop drivers ship today.
SCRUTINY_PROVIDER=mock          # mock | http
SCRUTINY_HTTP_URL=
SCRUTINY_HTTP_API_KEY=
SCRUTINY_CALLBACK_SECRET=dev-only-callback-secret

PAYMENT_PROVIDER=mock           # mock | razorpay | payu | ccavenue
PAYMENT_KEY_ID=                 # Razorpay key id · PayU merchant key · CCAvenue merchant id
PAYMENT_KEY_SECRET=             # Razorpay key secret · PayU salt · CCAvenue working key
PAYMENT_ACCESS_CODE=            # CCAvenue only
PAYMENT_API_BASE=               # Override the gateway host (staging endpoints)
PAYMENT_WEBHOOK_SECRET=dev-only-payment-webhook-secret
# A mock payment is not a payment. Required to run the mock gateway in production.
ALLOW_MOCK_PAYMENTS_IN_PRODUCTION=false

SMS_PROVIDER=mock               # mock | msg91
SMS_API_KEY=
SMS_SENDER_ID=

EMAIL_PROVIDER=console           # console | smtp
EMAIL_FROM="LAMS <no-reply@example.gov.in>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

ANTIVIRUS_PROVIDER=noop         # noop | clamav
CLAMAV_HOST=
CLAMAV_PORT=3310

# ── Guardrail: mock scrutiny in production ───────────────────────────────
# A mock PASS is not a compliance decision. The mock scrutiny provider refuses
# to run when NODE_ENV=production unless this is explicitly set to true, so
# deploying without a real provider is a conscious act. See docs P.7.
ALLOW_MOCK_SCRUTINY_IN_PRODUCTION=false

# ── Worker & jobs ────────────────────────────────────────────────────────
WORKER_ENABLED=true
WORKER_POLL_MS=2000
WORKER_CONCURRENCY=2
WORKER_ID=

# Bearer secret for /api/cron/* endpoints.
CRON_SECRET=dev-only-cron-secret

# ── The System Administrator ─────────────────────────────────────────────
# Seeded by `npm run db:seed`, in every mode. Leave BOTH unset to skip it —
# in demo mode `admin.demo@example.com` is created instead.
#
# The password must be at least 16 characters and is treated as a BOOTSTRAP
# credential: the account is required to change it at first sign-in, because
# by then this value has been through a shell, a file and probably a log.
#
# Re-seeding does NOT reset an existing administrator's password unless
# SUPER_ADMIN_RESET_PASSWORD=true, so a routine seed on a live system cannot
# quietly put the credential back to whatever this file still contains.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME="System Administrator"
SUPER_ADMIN_RESET_PASSWORD=false

# ── Demo mode ────────────────────────────────────────────────────────────
# Shows a persistent DEMO MODE banner and enables the demo account chips on the
# login page. Never enable in a real deployment.
DEMO_MODE=true
DEMO_PASSWORD=Demo@12345

# Guard on `npm run seed:demo:reset`, which TRUNCATEs every application table.
# The script refuses to run without it, so a reset cannot happen by autocomplete.
LAMS_ALLOW_DEMO_RESET=
# Fixed seed for the demo generator. The same value produces the same seventy
# applications on every machine, so a screenshot and a bug report agree.
DEMO_SEED=20260831

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=info                # debug | info | warn | error
