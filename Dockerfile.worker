# The worker is the same codebase with a different entrypoint. It runs tsx
# directly rather than a Next build, because it never serves HTTP.
FROM node:22-alpine
WORKDIR /app
RUN apk add --no-cache libc6-compat openssl && \
    addgroup -g 1001 -S nodejs && \
    adduser -S -u 1001 -G nodejs worker

COPY package.json package-lock.json* ./
COPY prisma ./prisma
RUN npm ci --ignore-scripts && npx prisma generate

COPY --chown=worker:nodejs src ./src
COPY --chown=worker:nodejs worker ./worker
COPY --chown=worker:nodejs tsconfig.json ./

ENV NODE_ENV=production
USER worker

# No port. The worker polls the database; nothing connects to it.
#
# --conditions=react-server resolves the `server-only` marker package to its
# no-op build. The worker IS server code, so this is the correct condition —
# without it `server-only` throws outside Next's bundler.
CMD ["npx", "tsx", "--conditions=react-server", "worker/index.ts"]
